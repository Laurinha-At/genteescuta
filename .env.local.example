# =============================================================
# GENTE ESCUTA — variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha com os seus dados.
# No Supabase: Project Settings → API
# =============================================================

# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave "service_role" (a secreta, NÃO a anon/public).
# Ela nunca vai para o navegador — só o servidor a utiliza.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# Endereço público do site. Usado para montar o link da pesquisa e o QR code.
# Em produção: https://seu-site.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
